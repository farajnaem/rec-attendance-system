# === Coolify (إنتاج) — قاعدة بيانات منفصلة تبقى عند إعادة نشر التطبيق ===
# انسخ DATABASE_URL من Coolify بعد ربط MySQL بالتطبيق:
# DATABASE_URL=mysql://mysql:PASSWORD@SERVICE_NAME:3306/default

# === التطبيق (Coolify) ===
APP_NAME=جمعية مركز الإرشاد التربوي REC
APP_URL=https://employee.rec-soc.org
APP_TIMEZONE=Asia/Riyadh
APP_DEBUG=false
SETUP_ENABLED=false
RUN_MIGRATIONS_ON_REQUEST=false

# === البريد ===
MAIL_FROM=noreply@example.com

# === بروكسي موثوق (IPs مفصولة بفاصلة، أو * للثقة الكاملة) ===
TRUSTED_PROXIES=

# === تطوير محلي — Docker Compose ===
# DB_DRIVER=mysql
# DB_HOST=db
# DB_PORT=3306
# DB_NAME=rec_attendance
# DB_USER=rec
# DB_PASS=change_me_strong_password

# === تطوير محلي — SQLite (اختياري) ===
# DB_DRIVER=sqlite
# DB_SQLITE_PATH=database/attendance.sqlite
# APP_URL=http://localhost:8080
